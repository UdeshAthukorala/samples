# Base URL of your ThunderID deployment. ex: https://localhost:8090
VITE_THUNDERID_BASE_URL=https://localhost:8090

# OAuth2 Client ID for this app. ThunderID Console -> your application -> Overview.
VITE_THUNDERID_CLIENT_ID=your-client-id-here

# Set to true to sign in through the Express BFF in ../express-bff instead of in the browser.
# The two variables above are then not needed. Start the BFF first.
# VITE_THUNDERID_BFF=true
# Where the dev server forwards /api/auth in BFF mode.
# BFF_URL=http://localhost:3001
